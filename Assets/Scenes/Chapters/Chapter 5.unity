  m_Script: {fileID: 11500000, guid: fe61c457b009a094792c22a0fd01b2a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicTrigger
  playerCam: {fileID: 1280946466}
  objectiveCam: {fileID: 2107182181}
  speakerName: Bear
  speakerPortrait: {fileID: 21300000, guid: a884dcc436b1e9a45918b680aefcc697, type: 3}
  dialogueLines:
  - "What the hell was that\u2026?"
  - "That wasn\u2019t normal. None of this is."
  - "Those things\u2026 the vines\u2026 this whole town\u2026 something bad happened
    here."
  - If people were still around when this started, they would've tried to gather
    somewhere safe.
  - "The Town Hall\u2026 that\u2019s probably where they\u2019d go."
  - "And maybe then\u2026 I\u2019ll finally figure out what\u2019s going on."
  - "There might be more of those\u2026 things nearby. I better stay sharp."
  playOnlyOnce: 1
  sceneLoader: {fileID: 0}
  loadNextSceneAfterDialogue: 0
  playerAttack: {fileID: 0}
  showTutorialAfterDialogue: 1
  tutorialStepID: playerStatsTutorial
  tutorialText: '<color=yellow>Health</color> affects survival.

    Recover health
    by using medical items.

    <color=#FF00FF>Satiety</color> affects combat strength.

    Recover
    satiety by consuming food.'
  cinematicIcon: {fileID: 0}
