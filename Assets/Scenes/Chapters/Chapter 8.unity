      propertyPath: playerCam
      value: 
      objectReference: {fileID: 1280946466}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: <<Just as Bear enters, he sees a yellow note by the toppled over closet.>>
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: ....!!
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: <<He glances over it, with his sharp eyes and reads it out loud>>
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"Beryl, if you somehow managed to read this note. We''re safe and sound
        elsewhere.."'
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"Somewhere where that ... thing can''t reach us. You must know about
        the Virus by now"'
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"It changed everything. And we were lucky to receive the news before
        it was too late."'
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '"If you want to know where to find us. Head beyond the edge of the
        City"'
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '"May God light y-.-/"'
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: <<It was cut off.>>
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: ....thank god you're all alright. I-- I hope.
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: <<Time to go.>>
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: ....thank god you're all alright. I-- I hope.
      objectReference: {fileID: 0}
    - target: {fileID: 8311326633778763960, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
