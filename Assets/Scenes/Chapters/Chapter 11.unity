    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: playerCam
      value: 
      objectReference: {fileID: 1280946466}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: <<Bear's eyes grew fixated on the Tumor once more.>>
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "What the hell\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "This thing is bigger than the entire Town Hall\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "It\u2019s like the whole building became part of it."
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "There\u2019s no way I can destroy it, it's too huge."
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: 'But beyond this thing... beyond this city... '
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: My family's out there.
      objectReference: {fileID: 0}
    - target: {fileID: 8029915844618636220, guid: dfa28042ab3c6db41b734ff3c80fe1a9, type: 3}
