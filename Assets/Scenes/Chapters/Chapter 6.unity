MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1319146291}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe61c457b009a094792c22a0fd01b2a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicTrigger
  playerCam: {fileID: 1280946466}
  objectiveCam: {fileID: 355614753}
  speakerName: Bear
  speakerPortrait: {fileID: 21300000, guid: a884dcc436b1e9a45918b680aefcc697, type: 3}
  dialogueLines:
  - A log book...?
  - "\"Mayor\u2019s Log \u2014 Day 12.\""
  - '"Unexplained infections continue across the town. Doctors still cannot determine
    the cause."'
  - "\"Mayor\u2019s Log \u2014 Day 30\""
  - '"The hospital has exceeded capacity. More people are becoming sick overnight."'
  - "\"Some patients are showing signs of violent behavior\u2026\""
  - '"Strange vine-like growths are appearing on the infected."'
  - "\"Mayor\u2019s Log \u2014 Day 41.\""
  - '"We have converted the Town Hall into a temporary medical shelter."'
  - '"Food, medicine, and beds are being moved inside while we await military assistance."'
  - "\"Mayor\u2019s Log \u2014 Day 58.\""
  - '"The roads are no longer safe."'
  - '"We can hear screaming from outside the barricades every night."'
  - "\"Mayor\u2019s Log \u2014 Day 73.\""
  - '"The vines started growing on the walls of the building."'
  - '"Something is growing inside the Town Hall."'
  - '"MAY GOD HELP US!!!!!"'
  playOnlyOnce: 1
  sceneLoader: {fileID: 0}
  loadNextSceneAfterDialogue: 0
  playerAttack: {fileID: 0}
  showTutorialAfterDialogue: 0
  tutorialStepID: 
  tutorialText: 
